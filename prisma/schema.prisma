// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  supabaseId        String?   @unique
  username          String?   @unique
  name              String
  email             String?   @unique
  avatarUrl         String?
  authProvider      String?   // "email", "google", etc.
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastPlayedAt      DateTime?
  totalGamesPlayed  Int       @default(0)
  totalWins         Int       @default(0)
  totalLosses       Int       @default(0)
  averageRank       Float?    @default(0)
  participants      Participant[]
  createdGames      Game[]    @relation("createdGames")
  stats             UserStats?
}

model Game {
  id                    Int          @id @default(autoincrement())
  code                  String       @unique
  status                String       @default("waiting") // waiting, in_progress, finished
  createdAt             DateTime     @default(now())
  startedAt             DateTime?
  endedAt               DateTime?
  maxPlayers            Int          @default(4)
  currentPlayers        Int          @default(0)

  // Game state
  currentTurn           Int?         // userId of player whose turn it is
  playerWithPower       Int?         // userId of player who has power (leads tricks)
  turnOrder             Json?        // Array of userIds in play order

  // Trick state
  trickNumber           Int          @default(0)
  firstTrickCompleted   Boolean      @default(false)
  currentTrickLeader    Int?         // userId who led this trick
  currentTrickSuit      String?      // Lead suit of current trick
  currentTrickCards     Json?        // [{userId, card, order}] for current trick

  // Card piles
  wastePile             Json         @default("[]") // Discarded cards from clean tricks

  // Relations
  createdBy             Int?
  creator               User?        @relation(fields: [createdBy], references: [id], name: "createdGames")
  participants          Participant[]

  @@index([status])
  @@index([createdBy])
  @@index([currentTurn])
}

model Participant {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId      Int
  hand        Json
  position    Int       // Player position in turn order
  isReady     Boolean   @default(false)
  hasFinished Boolean   @default(false) // Player has gotten away
  rank        Int?      // Final rank (1 = winner, last = Bhabhi)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  @@unique([gameId, position])
  @@unique([gameId, userId])
  @@index([userId])
  @@index([gameId])
}

model UserStats {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int      @unique
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  averageRank Float?   @default(0)
  updatedAt   DateTime @updatedAt
}
